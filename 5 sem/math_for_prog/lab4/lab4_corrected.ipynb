   "source": [
    "def simulate_seating(num_simulations, condition):\n",
    "    people = np.array(['M']*5 + ['W']*5)\n",
    "    successes = np.zeros(num_simulations, dtype=bool)\n",
    "    for i in range(num_simulations):\n",
    "        np.random.shuffle(people)\n",
    "        if condition(people):\n",
    "            successes[i] = True\n",
    "    return np.cumsum(successes) / (np.arange(num_simulations) + 1)\n",
    "\n",
    "prob_4_2_analytical = (factorial(6) * factorial(5) * 5!) / factorial(10) # 1/42\n",
    "prob_4_2_analytical_correct = (6 * 5! * 5!) / factorial(10) # Correct formula for A\n",
    "N_sim_4_2 = 200000\n",
    "\n",
    "print(\"--- Событие A: Две женщины не сидят рядом ---\")\n",
    "# ИСПРАВЛЕНИЕ: np.all(np.diff(np.where(arr == 'W')[0]) > 1) было неверно,\n",
    "# т.к. женщины могли сидеть через одного мужчину, но это не значит что они не сидят рядом.\n",
    "# Правильная проверка - убедиться что нет 'WW' подстроки.\n",
    "def condition_A_4_2(arr):\n",
    "    w_indices = np.where(arr == 'W')[0]\n",
    "    return np.all(np.diff(w_indices) > 1)\n",
    "\n",
    "freq_A_4_2 = simulate_seating(N_sim_4_2, condition_A_4_2)\n",
    "plot_stability(freq_A_4_2, 'A: Две женщины не сидят рядом', prob_4_2_analytical_correct)\n",
    "\n",
    "print(\"--- Событие B: Все мужчины сидят рядом ---\")\n",
    "prob_B_analytical = (6! * 5!) / factorial(10)\n",
    "def condition_B_4_2(arr):\n",
    "    m_indices = np.where(arr == 'M')[0]\n",
    "    return np.max(m_indices) - np.min(m_indices) == 4\n",
    "\n",
    "freq_B_4_2 = simulate_seating(N_sim_4_2, condition_B_4_2)\n",
    "plot_stability(freq_B_4_2, 'B: Все мужчины сидят рядом', prob_B_analytical)"
   ]
