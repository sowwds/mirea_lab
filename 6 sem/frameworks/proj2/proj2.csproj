<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src/ModuleContract/ModuleContract.csproj" />
    <ProjectReference Include="src/Modules/CatalogModule/CatalogModule.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="src/Modules/ReportModule/ReportModule.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="src/Modules/ExportModule/ExportModule.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="src/Modules/CycleAlphaModule/CycleAlphaModule.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="src/Modules/CycleBetaModule/CycleBetaModule.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="src/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Remove="src/**/*" />
    <EmbeddedResource Remove="tests/**/*" />
    <None Remove="src/**/*" />
    <None Remove="tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
